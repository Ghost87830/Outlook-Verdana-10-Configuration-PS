# Set reg keys to V 10
# Restart Outlook only if font settings need changing.

$ErrorActionPreference = 'Stop'

try {
    # Identify the interactive user
    $computer = Get-CimInstance Win32_ComputerSystem
    $loggedOnUser = $computer.UserName

    if ([string]::IsNullOrWhiteSpace($loggedOnUser)) {
        throw "No interactive user is logged on. No changes were made."
    }

    $account = New-Object System.Security.Principal.NTAccount($loggedOnUser)
    $sid = $account.Translate(
        [System.Security.Principal.SecurityIdentifier]
    ).Value

    $userHive = "Registry::HKEY_USERS\$sid"
    $registryPath = "$userHive\Software\Microsoft\Office\16.0\Common\MailSettings"

    if (-not (Test-Path $userHive)) {
        throw "The logged-on user's registry hive is not loaded."
    }

    # Verdana 10 pt font binary value
    [byte[]]$simpleFont = @(
        '3c,00,00,00,1f,00,00,f8,00,00,00,40,c8,00,00,00,00,00,00,00,00,00,00,00,00,22,56,65,72,64,61,6e,61,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00' -split ','
    ) | ForEach-Object {
        [Convert]::ToByte($_, 16)
    }

    function Convert-HtmlToBinary {
        param([string]$Html)
        return [System.Text.Encoding]::ASCII.GetBytes($Html)
    }

    # Compose font settings
    $composeHtml = @"
<html>
<head>
<style>
span.PersonalComposeStyle {
    mso-style-name:"Personal Compose Style";
    mso-style-type:personal-compose;
    mso-style-noshow:yes;
    mso-style-unhide:no;
    mso-ansi-font-size:10.0pt;
    mso-bidi-font-size:11.0pt;
    font-family:"Verdana",sans-serif;
    mso-ascii-font-family:Verdana;
    mso-hansi-font-family:Verdana;
    mso-bidi-font-family:"Times New Roman";
    mso-bidi-theme-font:minor-bidi;
    color:windowtext;
}
</style>
</head>
</html>
"@

    $replyHtml = $composeHtml.Replace(
        'PersonalComposeStyle', 'PersonalReplyStyle'
    ).Replace(
        'Personal Compose Style', 'Personal Reply Style'
    ).Replace(
        'personal-compose', 'personal-reply'
    )

    # Plain-text font settings
    $plainTextHtml = @"
<html>
<head>
<style>
p.MsoPlainText, li.MsoPlainText, div.MsoPlainText {
    mso-style-noshow:yes;
    mso-style-priority:99;
    mso-style-link:"Plain Text Char";
    margin:0cm;
    mso-pagination:widow-orphan;
    font-size:10.0pt;
    mso-bidi-font-size:10.5pt;
    font-family:"Verdana",sans-serif;
    mso-fareast-font-family:Aptos;
    mso-fareast-theme-font:minor-latin;
    mso-bidi-font-family:"Times New Roman";
    mso-bidi-theme-font:minor-bidi;
    mso-fareast-language:EN-US;
}
</style>
</head>
</html>
"@

    # Desired reg values
    $settings = @{
        ComposeFontSimple  = $simpleFont
        ComposeFontComplex = (Convert-HtmlToBinary $composeHtml)
        ReplyFontSimple    = $simpleFont
        ReplyFontComplex   = (Convert-HtmlToBinary $replyHtml)
        TextFontSimple     = $simpleFont
        TextFontComplex    = (Convert-HtmlToBinary $plainTextHtml)
    }

    # Check whether any font setting differs
    $needsUpdate = $false

    if (-not (Test-Path $registryPath)) {
        $needsUpdate = $true
    }
    else {
        foreach ($name in $settings.Keys) {
            $existing = Get-ItemPropertyValue `
                -Path $registryPath `
                -Name $name `
                -ErrorAction SilentlyContinue

            $desired = [byte[]]$settings[$name]

            if (
                $null -eq $existing -or
                $existing -isnot [byte[]] -or
                $existing.Length -ne $desired.Length -or
                [System.Linq.Enumerable]::SequenceEqual(
                    [byte[]]$existing,
                    [byte[]]$desired
                ) -eq $false
            ) {
                $needsUpdate = $true
                break
            }
        }
    }

    # Nothing to do if all six values are already correct
    if (-not $needsUpdate) {
        Write-Output "Font settings are already correct for $loggedOnUser."
        Write-Output "Configured font: Verdana 10 pt."
        Write-Output "No registry changes made. Outlook will not be restarted."
        exit 0
    }

    Write-Output "Font settings differ from the desired values. Applying changes..."

    # Detect Outlook before changing the registry
    $outlookProcesses = @(
        Get-Process -Name OUTLOOK -ErrorAction SilentlyContinue
    )

    $outlookWasRunning = $outlookProcesses.Count -gt 0

    # Close Outlook first so it cannot overwrite the new settings
    if ($outlookWasRunning) {
        Write-Output "Closing Outlook before updating font settings..."

        $outlookProcesses | Stop-Process -Force -ErrorAction Stop

        # Wait for Outlook processes to exit
        $timeout = (Get-Date).AddSeconds(30)

        do {
            Start-Sleep -Milliseconds 500
            $remaining = @(
                Get-Process -Name OUTLOOK -ErrorAction SilentlyContinue
            )
        } while ($remaining.Count -gt 0 -and (Get-Date) -lt $timeout)

        if ($remaining.Count -gt 0) {
            throw "Outlook did not close within 30 seconds. Font settings were not updated."
        }
    }

    # Create the key if necessary
    New-Item -Path $registryPath -Force | Out-Null

    # Write the desired binary values
    foreach ($name in $settings.Keys) {
        New-ItemProperty `
            -Path $registryPath `
            -Name $name `
            -PropertyType Binary `
            -Value ([byte[]]$settings[$name]) `
            -Force | Out-Null
    }

    Write-Output "Font settings successfully updated for $loggedOnUser."

    # Restart Outlook only if it was running before the update
    if ($outlookWasRunning) {
        Write-Output "Starting Outlook again..."

        Start-Process -FilePath "outlook.exe" -ErrorAction Stop

        Write-Output "Outlook restart requested successfully."
    }
    else {
        Write-Output "Outlook was not running. No restart required."
    }

    Write-Output "SUCCESS: Configured font: Verdana 10 pt."
    exit 0
}
catch {
    Write-Error "FAILED: $($_.Exception.Message)"
    exit 1
}
